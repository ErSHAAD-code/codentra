# Production environment reference. Real values are injected by the
# hosting platform's secret manager (Railway/Render/Vercel env vars) —
# this file documents what's required, it is never committed with real values.

NODE_ENV=production

# Database — managed Postgres connection string (Neon/Supabase/Railway)
DATABASE_URL=

# Redis — managed Redis connection string
REDIS_URL=

# Backend
API_PREFIX=api/v1
BACKEND_PORT=4000

# Frontend
NEXT_PUBLIC_API_URL=https://api.codentra.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://codentra.example.com

# Auth — generate with `openssl rand -base64 32`, rotate on any suspected leak
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# GitHub webhook — must match the secret configured in the GitHub App/webhook settings
GITHUB_WEBHOOK_SECRET=

# AI Provider
ANTHROPIC_API_KEY=

# Observability (Phase 7)
SENTRY_DSN=
LOG_LEVEL=info
