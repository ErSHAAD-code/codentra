# Staging mirrors production configuration but points at separate
# infrastructure, so migrations and deploys can be validated before
# they touch real user data.

NODE_ENV=staging
DATABASE_URL=
REDIS_URL=
API_PREFIX=api/v1
NEXT_PUBLIC_API_URL=https://api-staging.codentra.example.com/api/v1
NEXT_PUBLIC_APP_URL=https://staging.codentra.example.com
AUTH_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
GITHUB_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=
SENTRY_DSN=
LOG_LEVEL=debug
